# Copy this file to .env and fill in your Supabase project's values before running
# docker compose up --build. Database and Auth are hosted on Supabase, not run locally.

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co (Project Settings -> API)
SUPABASE_URL=
# anon public key (Project Settings -> API) - used by the frontend Supabase client
SUPABASE_ANON_KEY=

# --- Backend datasource (Supabase Postgres connection pooler) ---
# Project Settings -> Database -> Connection string -> "Session pooler" (JDBC form below)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=

# --- Backend (Spring Boot) ---
APP_CORS_ORIGIN=http://localhost:5173,http://localhost
SERVER_PORT=8080

# Groq (free, no billing required) - powers resume analysis, matching, interview prep,
# skill gap, career recommendations, and the AI chat assistant.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Frontend ---
FRONTEND_PORT=80
