# Copy this file to .env and adjust as needed before running docker compose up --build

# --- PostgreSQL ---
POSTGRES_DB=talentiq
POSTGRES_USER=talentiq
POSTGRES_PASSWORD=talentiq
# Host-side port for the postgres container (change if 5432 is already in use on your machine)
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/talentiq
SPRING_DATASOURCE_USERNAME=talentiq
SPRING_DATASOURCE_PASSWORD=talentiq
JWT_SECRET=change-this-to-a-long-random-string-in-production-please
APP_CORS_ORIGIN=http://localhost:5173,http://localhost
SERVER_PORT=8080

# Groq (free, no billing required) - powers resume analysis, matching, interview prep,
# skill gap, career recommendations, and the AI chat assistant.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@talentiq.ai
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Frontend ---
FRONTEND_PORT=80
